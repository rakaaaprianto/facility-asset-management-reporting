# ==============================================================================
# AMRS Infomedia - Production Environment Configuration Template (.env.example)
# Salin file ini menjadi .env pada server atau pasang pada Settings -> Environment Variables di Vercel
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (PostgreSQL / Neon Serverless)
# ------------------------------------------------------------------------------
# Gunakan connection string dengan PgBouncer (pooler) untuk deployment serverless di Vercel
# Contoh format: postgresql://USER:PASSWORD@ep-xyz-pooler.ap-southeast-1.aws.neon.tech/DBNAME?sslmode=require
DATABASE_URL="postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/amrs_db?sslmode=require"
# Untuk performa optimal di serverless (Vercel), tambahkan parameter berikut pada DATABASE_URL:
# ?pool_timeout=10&connection_limit=1
# Contoh lengkap: postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/amrs_db?sslmode=require&pool_timeout=10&connection_limit=1

# ------------------------------------------------------------------------------
# 2. SESSION & SECURITY
# ------------------------------------------------------------------------------
# Generate string acak 32-64 karakter untuk signing token sesi (HMAC-SHA256)
# Di Linux/Mac/Git Bash: openssl rand -hex 32
# Di PowerShell: [Convert]::ToHexString((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
SESSION_SECRET="ganti-dengan-kunci-rahasia-acak-minimal-32-karakter-di-produksi"

# URL Canonical aplikasi untuk CORS dan callback auth
# Mode Local: http://localhost:3000
# Mode Vercel: https://nama-projek-anda.vercel.app
APP_ORIGIN="https://nama-projek-anda.vercel.app"
NEXTAUTH_URL="https://nama-projek-anda.vercel.app"

# ------------------------------------------------------------------------------
# 3. OBJECT STORAGE (Lampiran Berkas Laporan)
# ------------------------------------------------------------------------------
# Pilihan Driver: "r2" (Cloudflare R2 - Disarankan untuk Vercel) atau "local" (Filesystem server)
# Catatan: Vercel bersifat stateless (ephemeral filesystem), wajib gunakan "r2" saat di Vercel!
STORAGE_DRIVER="r2"

# Kredensial Cloudflare R2 (Hanya dibutuhkan jika STORAGE_DRIVER=r2)
# Dapatkan di Cloudflare Dashboard -> R2 -> Manage R2 API Tokens -> Create API Token
R2_ACCOUNT_ID="isi_dengan_cloudflare_account_id_anda"
R2_ACCESS_KEY_ID="isi_dengan_r2_access_key_id"
R2_SECRET_ACCESS_KEY="isi_dengan_r2_secret_access_key"
R2_BUCKET_NAME="amrs-infomedia-attachments"

# Opsional: Jika kelak migrasi ke On-Premise S3 / MinIO internal kantor
# R2_ENDPOINT="https://minio.internal.infomedia.co.id"

# ------------------------------------------------------------------------------
# 4. EMAIL NOTIFICATIONS (Workflow Approval & Submission)
# ------------------------------------------------------------------------------
# Opsi A: Resend API (HTTP REST - Bekerja di jaringan cloud & port Wi-Fi kantor tertutup)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="Infomedia AMRS <notifications@yourdomain.com>"

# Opsi B: SMTP Fallback (Jika menggunakan server SMTP kantor / Gmail)
EMAIL_SMTP_HOST="smtp.gmail.com"
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER="user@example.com"
EMAIL_SMTP_PASS="app-password-smtp"
