# ==============================================================================
# AMRS Infomedia - Enterprise Production Environment Configuration Template (.env.example)
# Salin file ini menjadi .env pada root server aplikasi sebelum menjalankan kontainer atau node service
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & NETWORK CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT=3000

# URL Canonical aplikasi (sesuaikan saat alokasi subdomain korporat diberikan)
# Contoh lokal: http://localhost:3000
# Contoh korporat: https://fam-report.infomedia.co.id
APP_ORIGIN="https://fam-report.infomedia.co.id"
NEXTAUTH_URL="https://fam-report.infomedia.co.id"

# Whitelist domain yang diizinkan untuk Server Actions CSRF protection (pisahkan dengan koma jika lebih dari satu)
# Contoh: fam-report.infomedia.co.id, 10.10.20.15:3000, 127.0.0.1:3000
ALLOWED_ORIGINS="fam-report.infomedia.co.id,localhost:3000"

# ------------------------------------------------------------------------------
# 2. DATABASE (PostgreSQL - On-Premise / Linux VPS / Managed Cloud)
# ------------------------------------------------------------------------------
# Format standar PostgreSQL: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
# Contoh On-Premise / VPS internal:
DATABASE_URL="postgresql://amrs_user:StrongDBPassword123!@localhost:5432/infomedia_amrs?schema=public"

# ------------------------------------------------------------------------------
# 3. SESSION & ENCRYPTION SECURITY
# ------------------------------------------------------------------------------
# Kunci rahasia minimal 32 karakter untuk signing token sesi HMAC-SHA256
# Di Linux terminal: openssl rand -hex 32
# Di PowerShell: [Convert]::ToHexString((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
SESSION_SECRET="ganti-dengan-kunci-rahasia-acak-minimal-32-karakter-di-produksi"

# ------------------------------------------------------------------------------
# 4. OBJECT STORAGE (Lampiran Berkas & Bukti Laporan)
# ------------------------------------------------------------------------------
# Pilihan Driver:
# - "local" : Menyimpan berkas di filesystem server (folder uploads/) - ideal untuk VPS/Docker dengan persistent volume
# - "r2"    : Cloudflare R2 / S3-compatible Object Storage (atau MinIO internal)
STORAGE_DRIVER="local"

# Kredensial S3 / Cloudflare R2 / MinIO (Hanya dibutuhkan jika STORAGE_DRIVER=r2)
R2_ACCOUNT_ID="isi_dengan_account_id"
R2_ACCESS_KEY_ID="isi_dengan_access_key_id"
R2_SECRET_ACCESS_KEY="isi_dengan_secret_access_key"
R2_BUCKET_NAME="infomedia-amrs-attachments"
# Jika menggunakan S3 / MinIO internal Infomedia:
# R2_ENDPOINT="https://minio.internal.infomedia.co.id"

# ------------------------------------------------------------------------------
# 5. EMAIL NOTIFICATIONS (Workflow Approval & Submission)
# ------------------------------------------------------------------------------
# Opsi A: SMTP Server Kantor / Enterprise Mail Relay
EMAIL_SMTP_HOST="smtp.infomedia.co.id"
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER="noreply@infomedia.co.id"
EMAIL_SMTP_PASS="smtp-secure-password"
EMAIL_FROM="Infomedia AMRS <noreply@infomedia.co.id>"

# Opsi B: Resend API (Alternatif layanan transactional email)
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxx"
